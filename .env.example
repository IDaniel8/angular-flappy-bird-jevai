# Copy this file to `.env` and paste your own key.
# Get one at https://openrouter.ai/settings/keys
#
# IMPORTANT: anything prefixed NG_APP_ is embedded into the bundle at build time,
# which means it is readable by anyone who opens the built app.
# Keep this repo local, or move the call behind a proxy for anything public.
NG_APP_OPENROUTER_KEY=
